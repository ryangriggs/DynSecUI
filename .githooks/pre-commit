#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");
const { execFileSync } = require("child_process");

const root = execFileSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" }).trim();
const relativeFile = "app.js";
const file = path.join(root, relativeFile);

try {
  execFileSync("git", ["diff", "--quiet", "--", relativeFile], { cwd: root });
} catch {
  console.error("Version bump stopped: app.js has unstaged changes. Stage or stash them, then commit again.");
  process.exit(1);
}

const source = fs.readFileSync(file, "utf8");
const pattern = /^const APP_VERSION="(\d+)\.(\d+)\.(\d+)";(\r?)$/m;
const match = source.match(pattern);

if (!match) {
  console.error('Version bump stopped: expected const APP_VERSION="x.y.z"; near the top of app.js.');
  process.exit(1);
}

const next = `${match[1]}.${match[2]}.${Number(match[3]) + 1}`;
const updated = source.replace(pattern, `const APP_VERSION="${next}";$4`);
fs.writeFileSync(file, updated, "utf8");
execFileSync("git", ["add", "--", relativeFile], { cwd: root, stdio: "inherit" });
console.log(`Bumped DynSecUI version to ${next}`);
